always searrow 1256-126
always nearrow 1256-134
always nwarrow 1256-156
always twoheadrightarrow 1256-25-25-1235-1235-135
always twoheadleftarrow 1256-25-25-1235-1235-246
always rsh 1256-256-256-346
always curvearrowright 1256-26-26-135
always swarrow 1256-345
always curvearrowleft 1256-35-35-246

############
# Brackets #
############
always left( 6-5-126
always right) 6-5-345
always left[ 6-46-126
always right] 6-46-345
always left{ 6-456-126
always right} 6-456-345
always left| 6-456-1256
always right| 6-456-1256
always bracket( 126
always bracket) 345
always divide/ 34
#always open/ 12356
#always close/ 12356-5

#################
