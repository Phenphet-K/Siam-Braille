#-index-name: English Music Braille Code for text
#-display-name: English Music text
#
#+locale: en-us
#+type: music
#+contraction: no
#+grade: 1
#+dots: 6
#+direction: forward
#+system: English
#+description: This table is originally designed for Sao Mai Braille (SMB) software to get Braille output for music text parsed from MusicXML file. It might be useful for users who use SMB and want to define for specific languages rather than English.
#
#-copyright: Sao Mai Center for the Blind <www.saomaicenter.org/en>
#-license: LGPLv2.1
#
#  Copyright (C) 2023 by Sao Mai Center for the Blind <www.saomaicenter.org/en>
#
#  This file is part of liblouis.
#
#  liblouis is free software: you can redistribute it and/or modify it
#  under the terms of the GNU Lesser General Public License as
#  published by the Free Software Foundation, either version 2.1 of the
#  License, or (at your option) any later version.
#
#  liblouis is distributed in the hope that it will be useful, but
#  WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
#  Lesser General Public License for more details.
#
#  You should have received a copy of the GNU Lesser General Public
#  License along with liblouis. If not, see
#  <http://www.gnu.org/licenses/>.
#
# Created and maintained by: Dang Hoai Phúc <danghoaiphuc@gmail.com>
#
#-author: Dang Hoai Phúc <danghoaiphuc@gmail.com>
#-maintainer-name: Dang Hoai Phúc
#-maintainer-email: danghoaiphuc@gmail.com
#
#-updated: 2023-11-23
#
# Based on <http://www.brailleauthority.org/music/Music_Braille_Code_2015.pdf>

include unicode.dis
undefined 123456-1456
punctuation * 26-35
punctuation . 3
punctuation / 34
punctuation ( 2356
#punctuation ) 2356
nofor prepunc ( 2356
punctuation ) 2356
postpunc ) 2356

include spaces.uti
include latinLetterDef6Dots.uti
include chardefs.mus
include digits6Dots.uti

# SMUFL glyph symbols and names definitions
include smufl-symbols.mus
include smufl-names.mus

# Music text symbols
# definitions below are mostly used by SM Music Braille translation engine.
always flatsign 126
always sharpsign 146
always naturalsign 16
always nochord 6-6-1345-14

# process harmony classical analyst written with Roman I to VII.
# It's depricated in MusicXML 4.0 but still useful for old MusicXML files.
noback context `["vii"]~ @56-1236-24-24
noback context `["vi"]~ @56-1236-24
noback context `["v"]~ @56-1236
noback context `["iv"]~ @56-24-1236
noback context `["iii"]~ @56-24-24-24
noback context `["ii"]~ @56-24-24
noback context `["i"]~ @56-24

# Chord symbols when <kind> tag has no text attribute.
always augmentedchord 1-136-1245 #aug
always augmented-seventhchord 1-136-1245-3456-1245 #aug#g
always diminishedchord 256 #4
always diminished-seventhchord 256-3456-1245 #4#g
always dominantchord 3456-1245 ##g
always dominant-11thchord 3456-1-1 ##aa
always dominant-13thchord 3456-1-14 ##ac
always dominant-ninthchord 3456-24 ##i
always frenchchord 124-1235 #fr
always germanchord 1245-15-1235 #ger
always half-diminishedchord 256-3-3456-1245 #4'#g
always italianchord 24-2345 #it
always major-11thchord 134-1-245-3456-1-1 #maj#aa
always major-13thchord 134-1-245-3456-1-14 #maj#ac
always major-minorchord 134-134-1-245-3456-1245 #mmaj#g
always major-ninthchord 134-1-245-3456-24 #maj#i
always major-seventhchord 134-1-245-3456-1245 #maj#g
always major-sixthchord 3456-124 ##f
always minorchord 134 #m
always minor-11thchord 134-3456-1-1 #m#aa
always minor-13thchord 134-3456-1-14 #m#ac
always minor-ninthchord 134-3456-24 #m#i
always minor-seventhchord 134-3456-1245 #m#g
always minor-sixthchord 134-3456-124 #m#f
always neapolitanchord 1345 #n
always pedalchord 1234-15-145-1-123 #pedal
always powerchord 3456-15 #power or #5
always suspended-fourthchord 234-136-234-3456-145 #sus#d
always suspended-secondchord 234-136-234-3456-12 #sus#b
always tristanchord 2345-1235-24-234-2345-1-1345 #tristan

# rules for number and cap definition can be defined in include files for different languages if needed
numsign 3456
nonumsign 56
numericnocontchars abcdefghij

# Remove  no num sign dots 56 before accidentals
noback pass2 @56-16 @16
noback pass2 @56-126 @126
noback pass2 @56-146 @146

capsletter 6
begcapsword 6-6
endcapsword 6-3
lencapsphrase 3
begcapsphrase 6-6-6
endcapsphrase after 6-3

include en-ueb-chardefs.uti

